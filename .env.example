NODE_ENV=development
PORT=3000

# PostgreSQL (contenedor de docker-compose)
POSTGRES_USER=mitzuri
POSTGRES_PASSWORD=changeme
POSTGRES_DB=mitzuri

# Conexion del backend a PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=mitzuri
DB_PASSWORD=changeme
DB_NAME=mitzuri

# Alternativa a las DB_* de arriba
# DATABASE_URL=postgres://mitzuri:changeme@localhost:5432/mitzuri
# DB_SSL=false

# Secretos
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
PREVIEW_TOKEN_SECRET=cambiar-por-un-secreto-largo-y-aleatorio

# Admin creado por `npm run db:seed`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme
ADMIN_FULL_NAME=Admin

# Cloudflare R2
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_SECRET_ACCESS_KEY=
R2_BUCKET=
# Dominio publico desde el que se sirve el bucket
R2_PUBLIC_BASE_URL=

# Origen permitido por CORS
FRONTEND_URL=http://localhost:5173

# Nota: las variables VITE_* del frontend van en frontend/.env
# (ver frontend/.env.example)
